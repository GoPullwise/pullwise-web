/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-VEatZbMXBX3bkdwKs4FWTz0OdhnsleGhiZqiELGpJ9s='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/brand-mark.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
