{
  "name": "pullwise-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:layout": "node scripts/check-date-layout.mjs",
    "test:billing-layout": "node scripts/check-billing-usage-layout.mjs",
    "test:overview-layout": "node scripts/check-overview-layout.mjs",
    "test:currency-layout": "node scripts/check-currency-picker-layout.mjs",
    "test:mobile-layout": "node scripts/check-mobile-layout.mjs",
    "test:projects-layout": "node scripts/check-projects-layout.mjs",
    "test:watch": "vitest --passWithNoTests",
    "preview:workers": "npm run build && npx wrangler dev --var PULLWISE_API_ORIGIN:http://localhost:8080",
    "check:workers": "node scripts/check-cloudflare-config.mjs",
    "deploy:workers": "npm run check:workers && npm run build && npx wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright": "1.57.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
